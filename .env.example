# ============================================================
# BACKEND - TEMPLATE BIẾN MÔI TRƯỜNG (đẩy lên GitHub được)
# ============================================================
# Sao chép file này -> .env.development để chạy local
# Điền giá trị thật vào Render.com Dashboard (Environment tab) khi deploy

# Cổng server
PORT=5000
NODE_ENV=production

# ---- MySQL (Aiven) ----
# Lấy thông tin này từ: Aiven Console > Services > MySQL > Connection Info
DB_HOST=YOUR_AIVEN_HOST.aivencloud.com
DB_PORT=YOUR_AIVEN_PORT
DB_USER=avnadmin
DB_PASS=YOUR_AIVEN_PASSWORD
DB_NAME=next_home_db

# ---- Bảo mật JWT ----
# Dùng key ngẫu nhiên dài ít nhất 64 ký tự
# Tạo tại: https://generate-secret.vercel.app/64
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET

# ---- CORS ----
# URL Frontend trên Vercel (sẽ điền sau khi deploy Vercel xong)
FRONTEND_URL=https://YOUR_APP_NAME.vercel.app

# Nếu bạn dùng custom domain từ Mắt Bão, thêm cả 2:
# FRONTEND_URL=https://yourdomain.com

# ---- Cloudinary (Lưu trữ ảnh) ----
# Đăng ký miễn phí tại: https://cloudinary.com
# Lấy thông tin từ: Cloudinary Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
